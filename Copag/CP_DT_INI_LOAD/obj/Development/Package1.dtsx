                          lineageId="Package\FACT_VENTE\Tâche de flux de données\Source OLE DB.Outputs[Sortie de source OLE DB].Columns[CODE_CHARGEMENT]"
                          name="CODE_CHARGEMENT"
                          truncationRowDisposition="FailComponent" />
                        <outputColumn
                          refId="Package\FACT_VENTE\Tâche de flux de données\Source OLE DB.Outputs[Sortie de source OLE DB].Columns[CODE_ARTICLE]"
                          dataType="i4"
