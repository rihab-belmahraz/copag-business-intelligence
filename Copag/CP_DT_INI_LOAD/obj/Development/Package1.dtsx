                    <property
                      dataType="System.String"
                      description="Commande SQL à exécuter."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT
    CONVERT(INT, FORMAT(DATE_CHARGEMENT, 'yyyyMMdd')) AS DATE_KEY,
    DATE_CHARGEMENT,
    DAY(DATE_CHARGEMENT) AS JOUR,
    MONTH(DATE_CHARGEMENT) AS MOIS,
    YEAR(DATE_CHARGEMENT) AS ANNEE
