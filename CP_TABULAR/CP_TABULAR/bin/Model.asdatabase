            "sourceColumn": "PERTE",
            "sourceProviderType": "Integer"
          },
          {
            "name": "PRIX_VNT",
            "dataType": "decimal",
            "sourceColumn": "PRIX_VNT",
            "formatString": "#,0.00 \"€\";-#,0.00 \"€\";#,0.00 \"€\"",
            "sourceProviderType": "Currency",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\" ThousandSeparator=\"True\"><Currency LCID=\"1036\" DisplayName=\"€ Français (France)\" Symbol=\"€\" PositivePattern=\"3\" NegativePattern=\"8\" /></Format>"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "VENTE",
            "dataView": "full",
            "source": {
              "type": "query",
              "query": " SELECT [dbo].[VENTE].* FROM [dbo].[VENTE] ",
              "dataSource": "SqlServer DESKTOP-DN4EEMKDWH DW"
            }
          }
        ],
        "measures": [
          {
            "name": "Total Vendu",
            "expression": " SUM(VENTE[TOTAL_VENDU])"
          },
          {
            "name": "Total Chargee",
            "expression": " SUM(VENTE[TOTAL_CHARGEE])"
          },
          {
            "name": "Total Invendu",
            "expression": " SUM(VENTE[TOTAL_INVENDU])"
          },
          {
            "name": "Total Rendus",
            "expression": " SUM(VENTE[TOTAL_RENDUS])"
          },
          {
            "name": "Total Perte",
            "expression": " SUM(VENTE[PERTE])"
          },
          {
            "name": "Ventes TOT (T)",
            "expression": [
              "",
              "DIVIDE (",
              "    SUMX (",
              "        VENTE,",
              "        ( VENTE[TOTAL_VENDU] + VENTE[TOTAL_INVENDU] )",
              "            * RELATED ( DIM_ARTICLE[POIDS_ARTICLE] )",
              "    ),",
              "    1000000",
              ")",
              ""
            ]
          },
          {
            "name": "Ventes TOT (MAD) TTC",
            "expression": [
              "",
              "SUMX (",
              "    VENTE,",
              "    VENTE[TOTAL_VENDU] * VENTE[PRIX_VNT]",
              ")"
            ]
          },
          {
            "name": "Ventes TOT (MAD) HT",
            "expression": [
              "",
              "DIVIDE ( [Ventes TOT (MAD) TTC], 1.2 )"
            ]
          },
          {
            "name": "Invendu (T)",
            "expression": [
              "",
              "SUMX (",
              "    VENTE,",
              "    VENTE[TOTAL_INVENDU]",
              "        * RELATED ( DIM_ARTICLE[POIDS_ARTICLE] )",
              ")"
            ]
          },
          {
            "name": "% Invendu",
            "expression": [
              "",
              "DIVIDE ( [Total Invendu], [Total Chargee] )"
            ]
          },
          {
            "name": "% Perte",
            "expression": [
              "",
              "DIVIDE ( [Total Perte], [Total Chargee] )"
            ]
          },
          {
            "name": "Ventes Moyenne Journalière (T)",
            "expression": [
              "",
              "DIVIDE (",
              "    [Ventes TOT (T)],",
              "    DISTINCTCOUNT ( DIM_DATE[PK_Date] ),",
              "    0",
              ")"
            ]
          },
          {
            "name": "Ventes Moyenne Journalière (MAD) TTC",
            "expression": [
              "",
              "DIVIDE (",
              "    [Ventes TOT (MAD) TTC],",
              "    DISTINCTCOUNT ( DIM_DATE[PK_Date] ),",
              "    0",
              ")"
            ]
          },
          {
            "name": "Ventes Moyenne Journalière (MAD) HT",
            "expression": [
              "",
              "DIVIDE (",
              "    [Ventes TOT (MAD) HT],",
              "    DISTINCTCOUNT ( DIM_DATE[PK_Date] ),",
              "    0",
              ")"
            ]
          },
          {
            "name": "Ventes Jour Précédent",
            "expression": [
              "",
              "CALCULATE ( [Ventes TOT (T)], PREVIOUSDAY ( DIM_DATE[PK_Date] ) )"
            ]
          },
          {
            "name": "Evo Ventes T Daily %",
            "expression": [
              "",
              "VAR cur = [Ventes TOT (T)]",
              "VAR prev =",
              "    CALCULATE(",
              "        [Ventes TOT (T)],",
              "        DATEADD(DIM_DATE[PK_Date], -1, DAY)",
              "    )",
              "RETURN",
              "IF(",
              "    ISBLANK(prev),",
              "    BLANK(),",
              "    DIVIDE(cur - prev, prev)",
              ")"
            ],
            "formatString": "0.00 %;-0.00 %;0.00 %"
          },
          {
            "name": "Ventes Mois Précédent",
            "expression": [
              "",
              "CALCULATE (",
              "    [Ventes TOT (T)],",
              "    PREVIOUSMONTH ( DIM_DATE[PK_Date] )",
              ")"
            ]
          },
          {
            "name": "Evo Ventes Monthly %",
            "expression": [
              "",
              "DIVIDE (",
              "    [Ventes TOT (T)] - [Ventes Mois Précédent],",
              "    [Ventes Mois Précédent])/100"
            ],
            "formatString": "0.00 %;-0.00 %;0.00 %"
          },
          {
            "name": "Ventes Année Précédente",
            "expression": [
              "",
              "CALCULATE (",
              "    [Ventes TOT (T)],",
              "    PREVIOUSYEAR ( DIM_DATE[PK_Date] )",
              ")"
            ]
          },
          {
            "name": "Evo Ventes Yearly %",
            "expression": [
              "",
              "DIVIDE (",
              "    [Ventes TOT (T)] - [Ventes Année Précédente],",
              "    [Ventes Année Précédente]",
              ")/100"
            ],
            "formatString": "0.00 %;-0.00 %;0.00 %"
          },
          {
            "name": "Ventes YTD",
            "expression": [
              "",
              "TOTALYTD (",
              "    [Ventes TOT (T)],",
              "    DIM_DATE[PK_Date]",
              ")"
            ]
          },
          {
            "name": "Ventes Traditionnelle %",
            "expression": [
              "",
              "BLANK()"
            ]
          },
          {
            "name": "Ventes CAC %",
            "expression": [
              "",
              "BLANK()"
            ]
          }
        ],
